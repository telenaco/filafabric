{
  "id": "anycubic-kobra-3-max-v2",
  "name": "Anycubic Kobra 3 Max V2",
  "experimental": true,
  "single_filament": true,
  "firmware": "klipper",
  "source": "Anycubic Kobra 3 Max V2 published build volume and stock nozzle; FilaFabric experimental single-filament startup, not a factory preset.",
  "import_notes": ["Experimental single-filament profile. Level the bed on the printer and review the generated G-code before testing a small swatch. ACE 2 Pro colour changes are not configured."],
  "bed": { "width": 420, "depth": 420, "max_z": 500 },
  "nozzle_diameter": 0.4,
  "max_bed_temperature": 90,
  "print_defaults": { "layer_height": 0.2 },
  "extrusion": { "relative_e": true },
  "accel_syntax": "P_R_T",
  "printer_model_check": "Anycubic Kobra 3 Max V2",
  "start_position": { "x": 210, "y": 210, "z": 5 },
  "output": { "format": "gcode", "extension": ".gcode" },
  "limits": {
    "default_mode": "normal",
    "emit_to_gcode": false,
    "modes": { "normal": {
      "max_feedrate": { "x": 100, "y": 100, "z": 8, "e": 30 },
      "max_accel": { "x": 1000, "y": 1000, "z": 150, "e": 1000 },
      "accel_extruding": 1000, "accel_retracting": 1000, "accel_travel": 1000,
      "jerk": { "x": 5, "y": 5, "z": 0.3, "e": 3 }
    } }
  },
  "start_gcode": [
    "; EXPERIMENTAL: Anycubic Kobra 3 Max V2, one filament, no ACE 2 Pro tool changes",
    "; Requires a saved default bed mesh and a primed nozzle",
    "G90", "M140 S{bed_temp}", "M190 S{bed_temp}",
    "G28", "BED_MESH_PROFILE LOAD=default", "G90", "M83",
    "G1 Z5 F480", "G1 X210 Y210 F3000", "M109 S{first_layer_temp}", "G92 E0", "M107"
  ],
  "end_gcode": [
    "M400", "G90", "G1 Z{raise_z} F480", "M104 S0", "M140 S0", "M107", "M84"
  ]
}
